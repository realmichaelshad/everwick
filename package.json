{
  "name": "everwick",
  "version": "1.0.0",
  "private": true,
  "description": "Everwick: a concept habit and fitness tracker for iOS and Android (fictional brand), built with React Native and Expo.",
  "license": "MIT",
  "author": "Michael Shadpour (https://michaelshadpour.com)",
  "homepage": "https://everwick-app.vercel.app",
  "repository": "github:realmichaelshad/everwick",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_OFFLINE=1 expo start --web",
    "web": "EXPO_OFFLINE=1 expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "EXPO_OFFLINE=1 expo export --platform web",
    "start": "tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "tsx scripts/qa.ts",
    "doctor": "expo-doctor",
    "export:native": "EXPO_OFFLINE=1 expo export --platform ios --output-dir .qa/native-ios && EXPO_OFFLINE=1 expo export --platform android --output-dir .qa/native-android",
    "illustrations": "tsx scripts/sync-illustrations.ts",
    "e2e": "playwright test",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.5",
    "playwright": "1.63.0",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
